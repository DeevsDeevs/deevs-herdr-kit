{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    12,
    10
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "theme": "moss",
  "colors": {
    "accent": "#4fb38a",
    "accent_foreground": "#06140e",
    "blocked": "#e5484d"
  },
  "font_size": 13,
  "toast": "agent-tower",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "tower",
              "type": "block",
              "content": {
                "mod": "agent-tower"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tower-viewbar",
          "type": "block",
          "size": {
            "px": 32
          },
          "window_drag": true,
          "content": {
            "mod": "agent-tower",
            "props": {
              "viewBar": true
            }
          }
        },
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 42
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 8,
          "gap": 8,
          "children": [
            {
              "id": "invest-centre",
              "type": "column",
              "gap": 8,
              "children": [
                {
                  "id": "tower-watch",
                  "type": "block",
                  "size": {
                    "weight": 0.45
                  },
                  "content": {
                    "mod": "agent-tower",
                    "props": {
                      "stage": true,
                      "view": "watchlist",
                      "bar": false
                    }
                  }
                },
                {
                  "id": "work-view",
                  "type": "stack",
                  "active": "main",
                  "children": [
                    {
                      "id": "main",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "gap": 8,
                          "radius": 10,
                          "background": "background",
                          "lone": true,
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "focus": {
                            "width": 1,
                            "color": "accent"
                          },
                          "header": {
                            "content": {
                              "mod": "agent-tower",
                              "props": {
                                "paneHead": true
                              }
                            },
                            "height": 30,
                            "position": "top",
                            "reveal": "always"
                          }
                        }
                      }
                    },
                    {
                      "id": "tower-stage",
                      "type": "block",
                      "content": {
                        "mod": "agent-tower",
                        "props": {
                          "stage": true,
                          "bar": false
                        }
                      }
                    }
                  ],
                  "size": {
                    "weight": 0.55
                  }
                }
              ]
            },
            {
              "id": "tower-detail",
              "type": "column",
              "hidden": false,
              "size": {
                "px": 320
              },
              "min": 260,
              "max": 560,
              "children": [
                {
                  "id": "tower-panel",
                  "type": "block",
                  "content": {
                    "mod": "agent-tower-panel"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ]
    }
  ]
}
